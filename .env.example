# Where the /api/* rewrite forwards requests (server-side; no CORS needed).
API_PROXY_TARGET=https://api.dev.cospread.com

# Optional: call the API directly from the browser instead of through /api.
# The API must then include this app's origin in ALLOWED_ORIGINS.
# NEXT_PUBLIC_API_URL=http://localhost:7000

# Prefix for product image keys (same value as the dashboard's VITE_PUBLIC_FILE_BASE_URL).
NEXT_PUBLIC_FILE_BASE_URL=

# Display currency (ISO 4217).
NEXT_PUBLIC_CURRENCY=NGN
